# ============================================
# DentalAI — Environment Variables
# Copy this to .env and fill in your values
# ============================================
# Vite exposes vars prefixed with VITE_ to the client
# All others are server-side only

# --- App ---
VITE_APP_NAME=DentalAI
VITE_APP_URL=https://dentalai.vercel.app
VITE_SUPPORT_EMAIL=privacy@dentalai.co.ke
VITE_CLINIC_NAME=Nairobi Dental Care
VITE_CLINIC_PHONE=+254 700 123 456

# --- Emergency ---
VITE_EMERGENCY_PHONE=0800 720 571

# --- SMS / WhatsApp (Africa's Talking) ---
VITE_SMS_SENDER_ID=DentalAI
# Get these from https://account.africastalking.com
VITE_AFRICASTALKING_USERNAME=sandbox
VITE_AFRICASTALKING_API_KEY=your_api_key_here

# --- M-Pesa (Daraja API) ---
# Get these from https://developer.safaricom.co.ke
VITE_MPESA_CONSUMER_KEY=your_consumer_key
VITE_MPESA_CONSUMER_SECRET=your_consumer_secret
VITE_MPESA_PASSKEY=your_passkey
VITE_MPESA_SHORTCODE=174379

# --- Feature Flags ---
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_WHATSAPP_CAMPAIGNS=true
VITE_ENABLE_MPESA=true
